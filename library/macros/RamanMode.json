  },
  {
   "id": "bk",
   "type": "mul",
   "in": {
    "b": -3.14159265
   }
  },
  {
   "id": "r",
   "type": "exp"
  },
  {
   "id": "r2",
   "type": "mul"
  },
  {
   "id": "a2",
   "type": "neg"
  },
  {
   "id": "rc",
   "type": "mul"
  },
  {
   "id": "a1",
   "type": "mul",
   "in": {
    "b": 2
   }
  },
  {
   "id": "gx",
   "type": "mul"
  },
  {
   "id": "y1",
   "type": "z1"
  },
  {
   "id": "y2",
   "type": "z1"
  },
  {
   "id": "t1",
   "type": "mul"
  },
  {
   "id": "t2",
   "type": "mul"
  },
  {
   "id": "y",
   "type": "add"
  }
 ],
 "wires": [
  [
   "$freq",
   "wn.a"
  ],
  [
   "sr",
   "wn.b"
  ],
  [
