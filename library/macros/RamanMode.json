  ],
  [
   "rc",
   "a1.a"
  ],
  [
   "$in",
   "gx.a"
  ],
  [
   "sw",
   "gx.b"
  ],
  [
   "a1",
   "t1.a"
  ],
  [
   "y1",
   "t1.b"
  ],
  [
   "a2",
   "t2.a"
  ],
  [
   "y2",
