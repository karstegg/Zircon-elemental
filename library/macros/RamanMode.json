   "type": "div"
  },
  {
   "id": "w",
   "type": "mul",
   "in": {
    "b": 6.283185307
   }
  },
  {
   "id": "cw",
   "type": "cos"
  },
  {
   "id": "sw",
   "type": "sin"
  },
  {
   "id": "bn",
