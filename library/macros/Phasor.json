{
  "name": "Phasor",
  "doc": "0..1 ramp at freq Hz. Built from primitives: accumulator closed with z1.",
  "inputs": [{"name": "freq", "default": 440}],
  "outputs": {"out": "wrap.out"},
  "modules": [
    {"id": "sr", "type": "sr"},
    {"id": "inc", "type": "div"},
    {"id": "acc", "type": "add"},
    {"id": "wrap", "type": "frac"},
    {"id": "mem", "type": "z1"}
  ],
  "wires": [
    ["$freq", "inc.a"], ["sr", "inc.b"],
    ["mem", "acc.a"], ["inc", "acc.b"],
    ["acc", "wrap.in"], ["wrap", "mem.in"]
  ]
}
